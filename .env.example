# Copy to apps/api/.env for the API process (do not commit real secrets).

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Postgres (hosted — Render / Neon / etc.; use +psycopg for SQLAlchemy 2 + psycopg3) ---
# No local Docker compose in this repo; point at your deployed database.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR_HOST/sourcebook

# --- Redis (hosted — Upstash / Render / etc.; queue + rate limits) ---
REDIS_URL=redis://default:PASSWORD@YOUR_HOST:6379

# --- Auth ---
JWT_SECRET=dev-only-change-me-sourcebook

# --- OpenAI (or compatible) ---
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# --- Web search (Tavily preferred; DuckDuckGo fallback) ---
# Free tier: 1000 credits/month. basic = 1 credit per search.
TAVILY_API_KEY=
# auto | tavily | ddgs  (auto = Tavily when key set, else DuckDuckGo)
WEB_SEARCH_PROVIDER=auto
# basic (1 credit) | advanced (2 credits)
TAVILY_SEARCH_DEPTH=basic
TAVILY_FALLBACK_TO_DDGS=true

# --- Document storage (Cloudflare R2 recommended in production) ---
# When all four are set, every upload (Documents + Add workspace) goes to R2.
# Leave empty for local disk under UPLOAD_DIR.
# R2 dashboard → bucket → Settings → S3 API:
#   Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   Create API token with Object Read & Write on the bucket.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# UPLOAD_DIR=./data/uploads

# --- RAG ---
RAG_TOP_K=5
RAG_MIN_SCORE=0.22

# --- Ingest worker ---
INGEST_USE_QUEUE=true
INGEST_JOB_TIMEOUT_SECONDS=600

# --- Rate limits (per user per window) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_PER_WINDOW=20
RATE_LIMIT_INGEST_PER_WINDOW=10
RATE_LIMIT_AGENT_PER_WINDOW=10

# --- Dev helpers on login (NEVER true in production) ---
DEV_MODE=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true
# LOG_JSON=false   # human-readable lines in the terminal

# --- CORS (comma-separated; required for browser UI on another origin) ---
# Local Vite defaults work without this. Production example:
# CORS_ORIGINS=https://sourcebook-peach.vercel.app,http://127.0.0.1:5173,http://localhost:5173
